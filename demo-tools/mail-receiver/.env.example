# Vouch mail receiver — copy to .env and edit. Never commit .env.

# ---- identity / recipients -------------------------------------------------------
# Mail is accepted for <MAIL_ACCEPT local parts>@<MAIL_DOMAIN>; everything else gets 550.
MAIL_DOMAIN=vouch.local
MAIL_ACCEPT=business
# Testing only: accept any recipient.
MAIL_ACCEPT_ANY=false
# Banner / HELO name (default mail.<MAIL_DOMAIN>).
SMTP_HOSTNAME=

# ---- listeners -------------------------------------------------------------------
SMTP_HOST=0.0.0.0
SMTP_PORTS=25,2525
HTTP_HOST=0.0.0.0
HTTP_PORT=8025

# ---- limits ----------------------------------------------------------------------
MAX_MESSAGE_BYTES=15728640
MAX_ATTACHMENT_BYTES=10485760
MAX_ATTACHMENTS=10
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,xlsx,csv,txt

# ---- storage ---------------------------------------------------------------------
DATA_DIR=/data
RECENT_LIMIT=20
# Optional mirror to Akamai (Linode) Object Storage, S3-compatible. Leave empty to disable.
OBJ_ENDPOINT=
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=
OBJ_PREFIX=mail/

# ---- forwarding to the Vouch backend (private network) ---------------------------
# Backend intake endpoint; empty = store only (health reports "store-only").
BACKEND_INTAKE_URL=http://10.0.0.5:8101/v1/intake/email
# json = POST the IntakeRequest JSON (headers, body_text, body_html, attachments[], source, received_at)
# eml  = POST the raw message as message/rfc822
BACKEND_INTAKE_FORMAT=json
# Shared secret sent as INTAKE_SECRET_HEADER on every POST; also protects POST /inbound and
# POST /dead-letter/retry on this receiver. Generate one: openssl rand -hex 32
INTAKE_SHARED_SECRET=change-me
INTAKE_SECRET_HEADER=X-Vouch-Intake-Secret
DELIVERY_MAX_ATTEMPTS=6
DELIVERY_BACKOFF_BASE_S=1.0
DELIVERY_BACKOFF_MAX_S=60
DELIVERY_TIMEOUT_S=20

LOG_LEVEL=INFO
