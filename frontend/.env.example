# Default data source on first load: "mock" (built-in demo data) or "live" (FastAPI backend).
# The in-app switch overrides this and persists in localStorage.
VITE_API_MODE=mock

# Base URL of the Vouch FastAPI backend.
# Both VITE_API_BASE_URL (preferred) and VITE_API_URL (legacy) are supported.
VITE_API_BASE_URL=http://localhost:8101

# Force mock data even when the backend is reachable. Useful for demos.
# VITE_USE_MOCK=1
