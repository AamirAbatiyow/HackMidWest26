# Copy to backend/.env (`make setup` does this). Names only: never commit real values.
# Everything boots without these set. Missing Akamai services fall back locally and /health says so.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
VOUCH_HOST=0.0.0.0
VOUCH_PORT=8101
VOUCH_INFERENCE_PORT=8201
# Where this API is reachable (used for receipt links the frontend opens).
VOUCH_PUBLIC_URL=http://localhost:8101
# Comma-separated origins allowed to call the API (Vite dev server + preview).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Comma-separated API keys accepted in the X-API-Key header. Empty = auth disabled (local dev).
API_KEYS=

# --- LLM: Akamai Cloud Inference (OpenAI-compatible). The key is set locally and never committed. ---
AKAMAI_INFERENCE_BASE_URL=https://ws.akamai-workshops.com/v1
AKAMAI_INFERENCE_API_KEY=
AKAMAI_INFERENCE_MODEL=hackathon-chat
AKAMAI_EMBEDDING_MODEL=hackathon-embedding
# Team limits: 60 req/min, 100k tokens/min, 32k context, 4096 max output. The client keeps a margin.
LLM_PROVIDER=akamai
LLM_REQUESTS_PER_MINUTE=60
VOUCH_LLM_RPM=45
VOUCH_LLM_MAX_TOKENS=1024
# VOUCH_LLM_MODE: auto (live when the key is set) | live | offline (deterministic templates)
VOUCH_LLM_MODE=auto

# --- Risk model ---
# VOUCH_SCORER: auto (inference service -> in-process torch -> heuristic) | http | local | heuristic
VOUCH_SCORER=auto
VOUCH_INFERENCE_URL=http://localhost:8201
MODEL_REGISTRY_DIR=artifacts/models
VOUCH_MODEL_NAME=vouch-risk
VOUCH_LIME_SAMPLES=400

# --- Strands Decider (AWS sponsor classifier; advisory intake routing only, never a fraud verdict) ---
# The Decider picks the submission format and the exact parser tool. Unset = deterministic routing.
# Set DECIDER_URL (Terraform cloud-init / `make decider-local` print it) to switch it on; when the server is
# down, times out or is unsure (confidence below the threshold) the hackathon-chat classifier decides, then
# deterministic sniffing. DECIDER_ENABLED is optional: true/false forces it on/off regardless of the URL.
DECIDER_URL=
DECIDER_ENABLED=
DECIDER_MIN_CONFIDENCE=0.6
DECIDER_TIMEOUT_S=20
# Decision-classifier chain (format -> extraction tool -> kickback reason; one enum answer per question).
# auto = deterministic code decides obvious submissions (MIME type / extension / bytes) and a model (Decider,
# else hackathon-chat structured output) is asked only when ambiguous; always = every document submission
# runs the chain (demo / shadow evaluation); off = deterministic defaults only, never a model call.
INTAKE_CLASSIFIER=auto

# --- Audit store: Postgres (pgvector) when set, SQLite under data/ otherwise ---
# Akamai Managed Database URL looks like postgresql://user:pass@host:5432/vouch?sslmode=require
DATABASE_URL=

# --- Object Storage (Akamai/Linode S3-compatible) for invoice attachments; local disk when unset ---
# The bucket `vouch-invoices` exists at https://us-ord-10.linodeobjects.com (E3).
# Either OBJ_* or LINODE_OBJ_* names work (OBJ_* takes precedence).

# Primary naming (code reads these first):
OBJ_ENDPOINT=
OBJ_BUCKET=
OBJ_REGION=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=

# Fallback naming (if OBJ_ACCESS_KEY/OBJ_SECRET_KEY are unset, these are used):
LINODE_OBJ_ACCESS_KEY=
LINODE_OBJ_SECRET_KEY=

# Legacy naming (still read by some code paths):
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-ord-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Settlement: mock (simulated receipts) | xrpl (real XRPL testnet transactions) ---
SETTLEMENT_ADAPTER=mock
XRPL_NETWORK_URL=https://s.altnet.rippletest.net:51234
XRPL_WALLET_SEED=
XRPL_DESTINATION_ADDRESS=
# IOU (issued currency / stablecoin-style token) settings.
# The issuer is the account that issued the token; receivers must have a trustline to it.
# `make xrpl-wallets` sets up wallets, trustlines and writes all XRPL_* vars into .env.
XRPL_IOU_ISSUER=
XRPL_IOU_CURRENCY=USD
XRPL_USE_IOU=true
# XRP fallback scaling (used only when XRPL_USE_IOU=false or XRPL_IOU_ISSUER is empty).
XRPL_XRP_PER_USD=0.0001
# Use XRPL Batch transaction (XLS-56) when available on testnet; falls back to sequential if not.
XRPL_USE_BATCH=true
XRPL_EXPLORER_URL=https://testnet.xrpl.org/transactions/

# --- Money limits (integer cents) ---
VOUCH_APPROVAL_LIMIT_CENTS=500000
VOUCH_FAST_PAY_LIMIT_CENTS=250000
VOUCH_SINGLE_PAYMENT_LIMIT_CENTS=5000000
VOUCH_BATCH_LIMIT_CENTS=10000000

# --- Deployment facts shown on /health (set by cloud-init on the app Linode) ---
VOUCH_REGION=us-ord (Chicago)
VOUCH_MODEL_SERVER_URL=
VOUCH_BEHIND_NODEBALANCER=false
VOUCH_FIREWALL_LABEL=
VOUCH_VPC_LABEL=

# --- Tracing (OpenTelemetry) ---
OTEL_CONSOLE_EXPORTER=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Akamai deployment (read by make deploy-akamai / destroy-akamai; never written to files) ---
# LINODE_TOKEN=
